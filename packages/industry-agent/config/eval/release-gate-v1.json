{
  "version": "release-gate-v1",
  "minCorpusCases": 1000,
  "minCasesPerCategory": 50,
  "minBenchmarkCoverage": 1.0,
  "requiredCategories": [
    "SAME_NAME_ENTITY",
    "ALIAS_SHORT_NAME",
    "TYPO",
    "CHAINAGE_RANGE",
    "SIDE",
    "PROJECT_CONFLICT",
    "SECTION_NAME",
    "BOQ_CODE",
    "CONTEXT_REFERENCE",
    "IMAGE_RESERVED",
    "RAG_SCOPE_ACL",
    "KNOWLEDGE_SCOPE_CONFLICT",
    "INSUFFICIENT_EVIDENCE",
    "WRONG_MUTATION_TARGET",
    "BATCH_MUTATION",
    "TOOL_FAILURE",
    "LLM_TIMEOUT",
    "ZERO_RETRIEVAL",
    "HARD_NEGATIVE"
  ],
  "intentCandidateK": 3,
  "ragK": 10,
  "metricRules": {
    "intentCandidateRecallAtK": {"min": 0.98, "maxRegression": 0.01, "minSamples": 200},
    "intentMacroF1": {"min": 0.93, "maxRegression": 0.01, "minSamples": 200},
    "mentionSpanF1": {"min": 0.95, "maxRegression": 0.01, "minSamples": 200},
    "normalizationExactMatch": {"min": 0.99, "maxRegression": 0.005, "minSamples": 200},
    "entityRecallAt20": {"min": 0.98, "maxRegression": 0.005, "minSamples": 200},
    "entityRecallAt50": {"min": 0.995, "maxRegression": 0.002, "minSamples": 200},
    "entityHitAt1": {"min": 0.9, "maxRegression": 0.01, "minSamples": 200},
    "entityMrr": {"min": 0.94, "maxRegression": 0.01, "minSamples": 200},
    "ragRecallAtK": {"min": 0.95, "maxRegression": 0.01, "minSamples": 150},
    "ragNdcgAtK": {"min": 0.9, "maxRegression": 0.01, "minSamples": 150},
    "ragMrr": {"min": 0.9, "maxRegression": 0.01, "minSamples": 150},
    "ragGroundedness": {"min": 0.98, "maxRegression": 0.005, "minSamples": 150},
    "citationAccuracy": {"min": 0.99, "maxRegression": 0.002, "minSamples": 150},
    "toolSelectionAccuracy": {"min": 0.98, "maxRegression": 0.005, "minSamples": 150},
    "mutationWrongTargetRate": {"max": 0.0, "maxRegression": 0.0, "minSamples": 100},
    "approvalConsistency": {"min": 1.0, "maxRegression": 0.0, "minSamples": 100},
    "traceSpanCompleteness": {"min": 0.99, "maxRegression": 0.002, "minSamples": 1000},
    "tokenAccountingCompleteness": {"min": 0.99, "maxRegression": 0.002, "minSamples": 1000},
    "endToEndTaskSuccess": {"min": 0.95, "maxRegression": 0.01, "minSamples": 1000},
    "clarificationRate": {"minSamples": 1000},
    "manualStepsSaved": {"min": 2.0, "maxRegression": 0.25, "minSamples": 1000}
  },
  "criticalE2ECaseIds": ["p11-e2e-query-a", "p11-e2e-mutation-b", "p11-e2e-rag-c", "p11-e2e-fact-d"]
}
